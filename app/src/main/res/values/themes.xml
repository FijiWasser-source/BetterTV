<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Klar" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/focus</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Schwebende "Glas"-Tafel für Menüs, wie die Kontextmenüs von tvOS -->
    <style name="Theme.Klar.Sheet" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:colorAccent">@color/focus</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
