<?xml version="1.0" encoding="utf-8"?>
<!-- Startansicht. Ebenen: Hintergrundbild (Inhalt) · Uhr/Wetter (Inhalt) · Glas-Dock (Bedienung) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <!-- Uhr und Wetter direkt auf dem Bild -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="72dp"
        android:paddingTop="44dp"
        android:paddingEnd="72dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                style="@style/OnImage"
                android:fontFamily="sans-serif-light"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textSize="84sp" />

            <TextClock
                android:id="@+id/date"
                style="@style/OnImage"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="EEEE, d. MMMM"
                android:format24Hour="EEEE, d. MMMM"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weather_temp"
                style="@style/OnImage"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:textSize="56sp" />

            <TextView
                android:id="@+id/weather_text"
                style="@style/OnImage"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/weather_loading"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Unten: Name der gewählten App, darunter das Glas-Dock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="44dp">

        <TextView
            android:id="@+id/dock_label"
            style="@style/OnImage"
            android:layout_marginBottom="14dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="20sp" />

        <!-- Bedienebene: ein Glas für alles, was darin liegt (kein Glas auf Glas) -->
        <de.bettertv.launcher.GlassLayout
            android:id="@+id/dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="16dp"
            android:padding="12dp"
            app:glassDim="0.22"
            app:glassRadius="30dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dock_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/dock_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:text="@string/dock_empty"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="14dp"
                    android:background="#4DFFFFFF" />

                <FrameLayout
                    android:id="@+id/all_apps_button"
                    style="@style/DockButton"
                    android:contentDescription="@string/all_apps">

                    <ImageView style="@style/DockButtonIcon" android:src="@drawable/ic_apps" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/settings_button"
                    style="@style/DockButton"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/settings">

                    <ImageView style="@style/DockButtonIcon" android:src="@drawable/ic_settings" />
                </FrameLayout>
            </LinearLayout>
        </de.bettertv.launcher.GlassLayout>
    </LinearLayout>
</FrameLayout>
