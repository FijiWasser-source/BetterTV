<?xml version="1.0" encoding="utf-8"?>
<!-- Ebenen von hinten nach vorn: Hintergrund (Inhalt) · Kacheln (Inhalt) · Glasleiste (Bedienung) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingTop="40dp"
        android:paddingEnd="72dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Inhalt: Uhr und Datum direkt auf dem Hintergrund -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="@color/text"
                    android:textSize="72sp" />

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:format12Hour="EEEE, d. MMMM"
                    android:format24Hour="EEEE, d. MMMM"
                    android:textColor="@color/text_content_secondary"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Bedienebene: schwebende Glas-Kapsel mit Wetter und Einstellungen -->
            <de.klar.tvlauncher.GlassLayout
                android:id="@+id/glass_bar"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:elevation="10dp"
                android:paddingStart="24dp"
                android:paddingEnd="8dp"
                app:glassDim="0.28">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Text auf Glas: immer reinweiß, Hierarchie über Größe/Stärke -->
                    <TextView
                        android:id="@+id/weather_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/weather_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/weather_loading"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="8dp"
                        android:background="#40FFFFFF" />

                    <!-- Kreis, konzentrisch zur Kapsel: (60dp - 2×8dp) = 44dp -->
                    <FrameLayout
                        android:id="@+id/settings_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bar_button"
                        android:contentDescription="@string/settings"
                        android:focusable="true"
                        android:focusableInTouchMode="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_settings"
                            android:tint="@color/bar_icon_tint" />
                    </FrameLayout>
                </LinearLayout>
            </de.klar.tvlauncher.GlassLayout>
        </LinearLayout>

        <!-- Inhalt: App-Kacheln (feste Flächen, kein Glas) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="-14dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="-14dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="48dp" />
    </LinearLayout>
</FrameLayout>
