<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- TV-Banner (16:9), falls die App eines mitbringt -->
        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Sonst: Icon mittig auf einer Fläche in der Farbe der App -->
        <ImageView
            android:id="@+id/icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/sheen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/tile_sheen" />

        <View
            android:id="@+id/pin"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="top|end"
            android:layout_margin="9dp"
            android:background="@drawable/pin_dot"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Name erscheint nur unter der fokussierten Kachel -->
    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:alpha="0"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textSize="14sp" />
</LinearLayout>
