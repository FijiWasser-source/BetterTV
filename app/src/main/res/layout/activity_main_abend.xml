<?xml version="1.0" encoding="utf-8"?>
<!-- Startansicht im Design "Abend": Begrüßung, Pixel-Uhr, nummerierte Kacheln -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2C2F34"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="44dp"
        android:paddingEnd="64dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="0.92"
                    android:textColor="#FFFFFF"
                    android:textSize="46sp" />

                <!-- "Weiter mit …": zuletzt geöffnete App -->
                <FrameLayout
                    android:id="@+id/continue_button"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginStart="-10dp"
                    android:layout_marginTop="6dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingStart="20dp"
                    android:paddingEnd="30dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_play_badge" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/continue_caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.12"
                                android:text="@string/continue_with"
                                android:textColor="#3D5788"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/continue_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textColor="#1B2640"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Pixel-Uhr, Datum und Wetter -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <de.klar.tvlauncher.PixelText
                    android:id="@+id/pixel_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:blinkColon="true"
                    app:pixelColor="#FFFFFF"
                    app:pixelSize="7.5dp" />

                <de.klar.tvlauncher.PixelText
                    android:id="@+id/pixel_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:pixelColor="#8FB4FF"
                    app:pixelSize="2.4dp" />

                <de.klar.tvlauncher.PixelText
                    android:id="@+id/pixel_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:pixelColor="#FFB566"
                    app:pixelSize="2.4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mitte: das Maskottchen -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <de.klar.tvlauncher.Mascot
                android:id="@+id/mascot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dock_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-16dp"
            android:layout_marginEnd="-64dp"
            android:layout_marginBottom="40dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingEnd="64dp" />
    </LinearLayout>
</FrameLayout>
