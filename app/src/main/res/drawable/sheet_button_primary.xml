<?xml version="1.0" encoding="utf-8"?>
<!-- Hauptaktion: Farbe auf dem Hintergrund, nicht auf der Schrift (HIG Color) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/accent" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
